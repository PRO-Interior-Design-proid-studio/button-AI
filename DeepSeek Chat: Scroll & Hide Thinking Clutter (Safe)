// ==UserScript==
// @name         DeepSeek Chat: Scroll, Hide Clutter & Collapse + Token Counter (Event-based)
// @namespace    http://tampermonkey.net/
// @version      5.9
// @description  Кнопка прокрутки, скрытие мусора, сворачивание блоков >3 строк, счётчик токенов (обновление по событиям)
// @match        https://chat.deepseek.com/*
// @grant        none
// @run-at       document-idle
// ==/UserScript==

(function() {
    'use strict';

    // ===== 1. СТИЛИ (как в 5.8) =====
    const style = document.createElement('style');
    style.textContent = `
        /* Скрываем мусор */
        ._5ab5d64, ._60aa7fb, .e4c3fd02, ._8f7678d, .c2b72bb8,
        .ds-think-content, ._0fcaa63,
        [class*="disclaimer"], [class*="warning"] {
            display: none !important;
        }

        /* Сворачивание кода */
        .code-collapsible pre {
            max-height: 4.5em;
            overflow: hidden;
            transition: max-height 0.3s ease;
        }
        .code-collapsible.expanded pre {
            max-height: none;
        }
        .question-collapsible .fbb737a4 {
            max-height: 4.5em;
            overflow: hidden;
            transition: max-height 0.3s ease;
            position: relative;
        }
        .question-collapsible.expanded .fbb737a4 {
            max-height: none;
        }
        .collapse-toggle {
            position: absolute;
            bottom: 8px;
            right: 8px;
            z-index: 5;
            background: rgba(20, 20, 25, 0.85);
            backdrop-filter: blur(4px);
            border: 1px solid rgba(255,255,255,0.15);
            padding: 2px 10px;
            border-radius: 12px;
            font-size: 12px;
            color: #eee;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            font-family: inherit;
            transition: background 0.2s;
            user-select: none;
            pointer-events: auto;
        }
        .collapse-toggle:hover {
            background: rgba(40,40,50,0.9);
        }
        .collapse-toggle svg {
            width: 14px;
            height: 14px;
            fill: currentColor;
            transition: transform 0.3s;
        }
        .expanded .collapse-toggle svg {
            transform: rotate(180deg);
        }

        /* Индикатор токенов */
        #token-indicator {
            position: fixed;
            bottom: 82px;
            right: 28px;
            z-index: 9999;
            font-size: 13px;
            font-weight: 500;
            color: #aaa;
            background: rgba(20,20,25,0.7);
            backdrop-filter: blur(4px);
            padding: 4px 12px;
            border-radius: 12px;
            border: 1px solid rgba(255,255,255,0.08);
            font-family: inherit;
            pointer-events: auto;
            cursor: pointer;
            transition: color 0.2s;
            user-select: none;
        }
        #token-indicator:hover {
            color: #eee;
        }
        #token-indicator.warning { color: #f0ad4e; }
        #token-indicator.critical { color: #d9534f; }
    `;
    document.head.appendChild(style);

    // ===== 2. СЧЁТЧИК ТОКЕНОВ =====
    const TOKEN_LIMIT = 64000;
    const USER_MESSAGE_SELECTOR = 'div[data-um-id]';
    const AI_MARKDOWN_SELECTOR = 'div.ds-markdown';
    const AI_THOUGHT_SELECTOR = '[class*="ds-think-content"]';

    function getConversationText() {
        let text = '';
        try {
            const userMessages = document.querySelectorAll(
                `${USER_MESSAGE_SELECTOR} > div.ds-message > div:first-child`
            );
            userMessages.forEach(div => {
                text += div.innerText + '\n';
            });
            const aiBlocks = document.querySelectorAll(AI_MARKDOWN_SELECTOR);
            aiBlocks.forEach(div => {
                if (!div.closest(AI_THOUGHT_SELECTOR)) {
                    text += div.innerText + '\n';
                }
            });
        } catch (e) {}
        return text;
    }

    function calculateTokens(text) {
        const latinChars    = (text.match(/[a-zA-Z0-9\s.,!?;:'"(){}\[\]]/g) || []).length;
        const cyrillicChars = (text.match(/[а-яА-ЯёЁ]/g) || []).length;
        const chineseChars  = (text.match(/[\u4e00-\u9fa5]/g) || []).length;
        const otherChars    = text.length - latinChars - cyrillicChars - chineseChars;
        return Math.ceil(
            latinChars    * 0.25 +
            cyrillicChars * 0.55 +
            chineseChars  * 0.65 +
            otherChars    * 0.4
        );
    }

    let tokenIndicator = null;

    function updateTokenIndicator() {
        if (!tokenIndicator) return;
        try {
            const text = getConversationText();
            const used = calculateTokens(text);
            const remaining = Math.max(0, TOKEN_LIMIT - used);
            tokenIndicator.textContent = `Осталось: ${remaining.toLocaleString()}`;
            tokenIndicator.classList.remove('warning', 'critical');
            if (remaining < 1000) {
                tokenIndicator.classList.add('critical');
            } else if (remaining < 5000) {
                tokenIndicator.classList.add('warning');
            }
        } catch (e) {}
    }

    // ===== 3. СОБЫТИЙНОЕ ОБНОВЛЕНИЕ =====
    function setupAssistantObserver() {
        const assistantObserver = new MutationObserver(() => {
            const newMessages = document.querySelectorAll('.ds-message:not([data-token-counted])');
            let hasNew = false;
            newMessages.forEach(msg => {
                if (msg.querySelector('.ds-assistant-message-main-content')) {
                    msg.dataset.tokenCounted = 'true';
                    hasNew = true;
                }
            });
            if (hasNew) {
                clearTimeout(window._tokenUpdateTimeout);
                window._tokenUpdateTimeout = setTimeout(updateTokenIndicator, 800);
            }
        });
        assistantObserver.observe(document.body, { childList: true, subtree: true });
    }

    function setupSendObserver() {
        const sendButton = document.querySelector('button[type="submit"]') ||
                           document.querySelector('div[role="button"][aria-label="Send"]') ||
                           document.querySelector('button:has(svg)');
        if (sendButton) {
            sendButton.addEventListener('click', () => {
                setTimeout(updateTokenIndicator, 200);
            });
        }
        const textarea = document.querySelector('textarea[placeholder*="Message"]');
        if (textarea) {
            textarea.addEventListener('keydown', (e) => {
                if (e.key === 'Enter' && !e.shiftKey) {
                    setTimeout(updateTokenIndicator, 200);
                }
            });
        }
    }

    // ===== 4. ОСТАЛЬНАЯ ЛОГИКА (сворачивание, скрытие) =====
    // (здесь всё то же, что в версии 5.8 — я не буду дублировать полный код,
    //  но в финальном скрипте вы должны оставить все функции applyCollapse, processBlock, hideUserBlock и т.д.)

    // ===== 5. ЗАПУСК =====
    setTimeout(() => {
        setupAssistantObserver();
        setupSendObserver();
        updateTokenIndicator(); // первое обновление
        // applyCollapse();      // уже вызвано раньше
    }, 1000);

    // ... остальное (кнопка, SPA-поддержка) остаётся без изменений

})();
